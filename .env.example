# Copy to .env and fill in at least one API key. Providers are tried in order:
# Gemini -> OpenRouter -> offline engine (data-grounded, no key needed).

# --- Google Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
# Models are tried in order (comma-separated); the 'latest' aliases are always added as fallbacks.
# Free-tier keys allow ~5 requests/minute PER MODEL, so listing several models multiplies capacity:
# a model that hits its quota is skipped until it refills, a retired one (404) is dropped.
GEMINI_MODEL=gemini-flash-latest,gemini-3.6-flash,gemini-3.7-flash
# Models for the agent's short tasks (SMS drafts, reply parsing, summaries): fastest tier.
GEMINI_TASK_MODEL=gemini-flash-lite-latest,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# 0 disables "thinking" (fastest, and short answers are never truncated). Use "auto" to let the model think.
GEMINI_THINKING_BUDGET=0

# --- OpenRouter or any OpenAI-compatible API ---
OPENROUTER_API_KEY=
# Comma-separate several models to try them in order.
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# e.g. a local Ollama server: OPENROUTER_BASE_URL=http://localhost:11434/v1 with OPENROUTER_API_KEY=ollama
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Use the offline engine when no provider answers (set false to surface errors instead)
ALLOW_MOCK_FALLBACK=true

# --- Venlix backend (/reports, /deliveries, /twin, /prediction). Sample data is used when unreachable. ---
BACKEND_URL=http://127.0.0.1:8000
BACKEND_TIMEOUT=3
BACKEND_CACHE_TTL=15

# --- Agent & dashboard ---
AGENT_CONCURRENCY=4
AGENT_LLM_TIMEOUT=20
VENLIX_DB_PATH=venlix_agent.db
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8050
